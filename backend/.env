# Konfigurasi Server
PORT=8000
FRONTEND_URL=http://localhost:5173
APP_NAME=SMK Pertiwi Chatbot

# Konfigurasi Gemini
GEMINI_MODEL=gemini-1.5-flash
MAX_TOKENS=1000
TEMPERATURE=0.7
# Web Search
ENABLE_WEB_SEARCH=true
AUTO_WEB_SEARCH=false
WEB_SEARCH_RESULTS=5
WEB_SEARCH_CACHE_TTL=1800
WEB_SEARCH_CACHE_MAX=120
# Rate Limit
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_WINDOW=60
MIN_REQUEST_INTERVAL=1.2
# Moderation
MODERATION_ENABLED=true
MODERATION_BLOCKLIST=anjing,babi,bangsat,brengsek,kontol,memek,ngentot,goblok,tolol,fuck,shit
# SerpAPI (gunakan jika ENABLE_WEB_SEARCH=true)
